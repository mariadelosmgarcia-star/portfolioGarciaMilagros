// Recuperación automática de rutas de imágenes
function handleImgError(img) {
  const originalSrc = img.getAttribute('src');
  if (!originalSrc) return;

  if (img.dataset.failedAttempts >= 4) {
    img.style.display = 'none'; // Si no existe el archivo, se oculta limpiamente sin romper el diseño
    return;
  }

  img.dataset.failedAttempts = (parseInt(img.dataset.failedAttempts) || 0) + 1;
  const fileName = originalSrc.split('/').pop();

  if (img.dataset.failedAttempts === 1) {
    // Intento 1: Buscar la imagen en la raíz directa (por si no está dentro de images/)
    img.src = fileName;
  } else if (img.dataset.failedAttempts === 2) {
    // Intento 2: Probar formato .jpg / .jpeg / .png
    if (fileName.endsWith('.png')) {
      img.src = 'images/' + fileName.replace('.png', '.jpg');
    } else if (fileName.endsWith('.jpeg')) {
      img.src = 'images/' + fileName.replace('.jpeg', '.jpg');
    } else if (fileName.endsWith('.jpg')) {
      img.src = 'images/' + fileName.replace('.jpg', '.png');
    }
  } else if (img.dataset.failedAttempts === 3) {
    // Intento 3: Probar raíz directa con otra extensión
    if (fileName.endsWith('.png')) {
      img.src = fileName.replace('.png', '.jpg');
    } else if (fileName.endsWith('.jpg')) {
      img.src = fileName.replace('.jpg', '.png');
    }
  }
}

